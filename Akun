            width: 340px;
            border-radius: 24px;
            border: 3px solid black; /* Bold border from image */
            padding: 20px;
            position: relative;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-header h2 {
            font-size: 18px;
            font-weight: 800;
            color: black;
        }

        .close-icon {
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 24px;
            height: 24px;
            border: 2px solid black;
            border-radius: 50%;
            font-weight: bold;
            font-size: 14px;
            transition: 0.2s;
        }
        
        .close-icon:hover {
            background-color: #f0f0f0;
        }

        .lang-option {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            cursor: pointer;
            font-weight: 700;
            font-size: 16px;
        }

        .divider {
            height: 1px;
            background-color: #ddd;
            margin: 5px 0;
        }

        /* Custom Radio Button using accent-color */
        .lang-option input[type="radio"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: #ff0000; /* Red color for selection */
        }

        .btn-confirm {
            position: absolute;
            bottom: -22px; /* Overlaps the bottom edge */
            left: 50%;
            transform: translateX(-50%);
            background-color: #ff0000;
            color: white;
            border: 2px solid black; /* Bold border */
            border-radius: 30px;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            width: 80%;
            transition: 0.2s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .btn-confirm:hover {
            background-color: #cc0000;
            transform: translateX(-50%) scale(1.02);
        }

        .message-box-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.4);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }
        .message-box {
            background: white;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            max-width: 400px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            border: 2px solid #ccc;
        }
        .message-box p {
            margin-bottom: 20px;
            font-size: 15px;
            font-weight: 500;
            white-space: pre-line;
        }
        .message-box button {
            background: #1e3d59;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }

