<body>

    <div class="top-promo-bar">
        Dapatkan POTONGAN 10% di Aplikasi LBus! Gunakan kode <b>PRIMER</b> di Aplikasi. <button style="padding: 2px 8px; font-size: 11px; cursor:pointer;">Unduh Aplikasi</button>
    </div>

    <header>
        <div class="container navbar">
            <div class="logo">
                <!-- Using placeholders in case local images are not found, maintaining user's structure -->
                <img src="logolbus.jpg" alt="LBus" width="120" onerror="this.src='https://placehold.co/120x40/1e3d59/white?text=LBus'">
                <img src="tiketbus.jpg" alt="Tiket" class="navbar-logo" width="40" onerror="this.src='https://placehold.co/40x40/ccc/333?text=Bus'"> 
            </div>
            <ul class="nav-links">
                <!-- Added ID and onclick event to trigger the modal -->
                <li><a id="langToggle" onclick="openLangModal()">🌐 <span id="currentLang">ID</span></a></li>
