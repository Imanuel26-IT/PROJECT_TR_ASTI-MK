<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LBus - Tempat Pemesanan Tiket Nomor 1 di Indonesia</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        body {
            background-color: #f7f9fa;
            color: #333;
            overflow-x: hidden;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .top-promo-bar {
            background-color: #fff9db;
            text-align: center;
            padding: 8px 10px;
            font-size: 13px;
            border-bottom: 1px solid #ffe066;
        }

        .top-promo-bar button {
            background-color: transparent;
            border: 1px solid #333;
            border-radius: 4px;
            margin-left: 10px;
        }

        header {
            background-color: #ffffff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
            flex-wrap: wrap;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            list-style: none;
            font-size: 14px;
            font-weight: 600;
            flex-wrap: wrap;
        }

        .nav-links a {
            text-decoration: none;
            color: #333;
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            padding: 5px 8px;
            border-radius: 5px;
            transition: background 0.2s;
        }

        .nav-links a:hover {
            background-color: #f0f0f0;
        }

        .hero {
            background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('gambarbatik.jpg');
            background-size: cover;
            background-position: center;
            background-color: #800000; /* Fallback color */
            padding: 60px 0 80px 0;
            text-align: center;
            color: white;
        }

        .hero h1 {
            font-size: 28px;
            margin-bottom: 30px;
        }

        .search-box {
            background: white;
            padding: 20px;
            border-radius: 25px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            max-width: 900px;
            margin: 0 auto;
            border: 2px solid #ccc;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            text-align: left;
            border-right: 1px solid #eee;
            padding-right: 10px;
            position: relative; /* Ditambahkan agar dropdown presisi di bawah input */
        }
        
        .input-group:last-of-type {
            border-right: none;
        }

        .input-group label {
            font-size: 12px;
            color: #777;
            margin-bottom: 5px;
        }

        .input-group input {
            padding: 8px 0;
            border: none;
            outline: none;
            font-size: 14px;
            color: #333;
            font-weight: bold;
        }

        .btn-search {
            grid-column: 1 / -1;
            background-color: #ff0000;
            color: white;
            border: none;
            padding: 12px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.3s;
        }

        .section-title {
            background-color: #ffcccc;
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px 20px 0 0;
            font-weight: bold;
            margin-top: 40px;
            font-size: 16px;
        }

        .section-box {
            background: white;
            border: 1px solid #ddd;
            border-radius: 0 15px 15px 15px;
            padding: 25px;
            margin-bottom: 20px;
        }

        .mitra-container {
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .mitra-container img {
            max-height: 50px;
            object-fit: contain;
        }

        .promo-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .promo-card {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            transition: 0.3s;
        }

        .promo-card img {
            width: 100%;
            height: auto;
            display: block;
        }

        .download-banner {
            margin: 40px 0;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .download-banner img {
            width: 100%;
            display: block;
        }

        .info-text {
            font-size: 12px;
            color: #555;
            line-height: 1.6;
            margin-bottom: 40px;
            text-align: justify;
        }

        .info-text h3 {
            margin: 15px 0 5px 0;
            color: #222;
        }

        .footer-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            padding: 30px 0;
            border-top: 1px solid #ddd;
            font-size: 13px;
        }

        .footer-links a {
            display: block;
            color: #0066cc;
            text-decoration: none;
            margin-bottom: 8px;
        }

        footer {
            background-color: #fff;
            padding: 20px 0;
            border-top: 1px solid #eee;
            font-size: 12px;
            color: #777;
            text-align: center;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            backdrop-filter: blur(2px);
        }

        .language-modal {
