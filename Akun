        }

        .payment-empty p {
            color: #777;
            max-width: 450px;
            font-size: 16px;
            line-height: 1.5;
        }

        /* --- TAMBAHAN CSS UNTUK MENU BARU --- */
        .order-card {
            border: 1px solid #ddd;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
        }
        .order-brand {
            color: #0066cc;
            font-weight: 800;
            font-size: 15px;
